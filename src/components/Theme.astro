<button id="theme-toggle" title="Toggle light & dark">
  <div i-uil-sun dark:i-uil-moon></div>
</button>

<script>
  let isDark: boolean

  const handleToggle = (event: MouseEvent) => {
    const element = document.documentElement
    const toggle = () => {
      element.classList.toggle('dark')
      isDark = element.classList.contains('dark')
      localStorage.setItem('theme', isDark ? 'dark' : 'light')
    }
    if (!document.startViewTransition) return toggle()
    const x = event.clientX
    const y = event.clientY
    const endRadius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
    const transition = document.startViewTransition(() => toggle())
    transition.ready.then(() => {
      const clipPath = [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`]
      element.animate(
        {
          clipPath: isDark ? clipPath.reverse() : clipPath,
        },
        {
          duration: 400,
          easing: 'ease-out',
          fill: 'forwards',
          pseudoElement: isDark ? '::view-transition-old(root)' : '::view-transition-new(root)',
        },
      )
    })
  }
  document.getElementById('theme-toggle')?.addEventListener('click', (event) => handleToggle(event))
</script>
